# Copy to .env for local work. Never commit .env. Full guide: docs/deploy.md

# Postgres connection string.
# Local: the Docker database from `npm run db:up`.
# Production (Vercel): the Neon pooled string (host contains "-pooler", ends with ?sslmode=require).
DATABASE_URL=postgresql://terra:terra@localhost:5434/terra_ops

# Signs session cookies. At least 32 characters. Generate with: openssl rand -base64 32
# Use a different value for production. Changing it logs everyone out.
BETTER_AUTH_SECRET=

# Public URL of the app, no trailing slash.
# Production: the exact https URL people open. Login fails if it does not match.
BETTER_AUTH_URL=http://localhost:3000
